# jhttpd, in nginx's shape.
#
# Every flag has a directive here, and a flag always overrides what this file
# says -- so you can keep a config and still `--port 9000` for an afternoon
# without editing it.
#
# What jhttpd does NOT do is guess. An unknown directive, a number that is not
# one, or a block that is missing half of a pair all stop the server with a
# line number, because a config that half-applied is how a server ends up not
# doing what you believe it is doing.

# --- the process -------------------------------------------------------

# user NAME [GROUP];   drop to this identity once the port is bound.
# user        www-data www-data;

# **Required if you run the packaged systemd unit**, which is Type=forking:
# systemd waits for the parent to exit and follows the pidfile to the real
# process.  Without it the start hangs until TimeoutStartSec -- though
# ExecStartPre refuses it first, in a second, saying so.
#
# Leave it out when running in the foreground from a shell.
# daemon;              or `daemon off;` -- absent means off.
#
# SIGHUP re-reads this file and applies what a running server can change:
#
#   ssl_certificate / _key   re-read from disk, so a renewed certificate is
#                            picked up without a restart -- which is the case
#                            that needs it, since certbot rewrites the same
#                            path every couple of months
#   auth_basic_user_file     re-read, so a user can be added or removed
#   request_rate / _burst    applied live
#   access_log / error_log   reopened, for rotation.  The *paths* need a
#                            restart, which a reload says rather than applying
#                            half of it
#   the error log's level    applied live, because the moment you want `info`
#                            is the moment you can least afford a restart
#
# Everything else -- listen, root, index, the server and location blocks, the
# thread count, the user -- was consumed at startup and needs a restart. A
# reload says so for each one it finds changed rather than keeping it quietly.
#
# A config that does not parse is refused whole: the server keeps running on
# what it had, and says why.
# pid         /var/run/jhttpd.pid;
# allow_root;          run as root anyway, which you almost never want.

threads     4;

# **Turn this on for anything real.**
#
# The two servers are not equals dressed differently. The async one carries a
# connection as a coroutine on a reactor -- a frame rather than a stack -- and
# it is the one with a connection cap, keepalive, and per-phase timeouts, which
# is to say the one with defences against a client that opens sockets and says
# nothing. It is what the six sites this was written for run.
#
# The blocking server gives each connection a pool thread for the length of
# that connection: one request per connection, no keepalive, and nothing
# bounding a slow client except io_timeout on each individual read. That is
# fine for a fixture and fine behind something else, and it is deliberately
# simple to reason about -- which is why the suite runs every property through
# it as well, and why `net_http_hostile_test` compares the two answer by
# answer. It is not what you would expose to the internet.
#
# Four settings below are read only by the async server and `--test` says so
# when you set them without this: max_connections, keepalive_requests,
# keepalive_timeout, client_header_timeout.
async;
# The error log, and the level below which nothing is written.
#
#   error_log PATH [LEVEL];     "-" is stderr
#
# Levels are Apache's, most urgent first:
#
#   emerg alert crit error warn notice info debug
#
# `notice` is the default and is where the lifecycle lines live -- started,
# reloaded, caught a signal -- which are what let a log be dated against a
# deploy.  A misspelled level is refused at startup rather than assumed,
# because a log that is quieter than you asked for reads like a quiet day.
#
# **Changing it takes effect on SIGHUP**, without a restart and without
# dropping a connection: edit this line, `systemctl reload jhttpd`, and the
# next request is sorted by the new level.
#
# **`info` is where the noise is.**  Measured on six live sites: 540 error
# lines in a day, of which 351 were failed TLS handshakes from scanners and
# 151 were peers that connected and went away.  None of it is actionable, so
# none of it is an error -- but `error_log ... info;` brings it all back for
# the afternoon you are debugging a client that cannot connect.
error_log   -;

# --- the server --------------------------------------------------------

http {
    # listen PORT, or ADDR:PORT -- and repeatable, which is what lets one
    # process serve http and https the way Apache and nginx do.
    #
    #   ssl       this port presents the certificate below
    #   redirect  this port answers 301 and points at the ssl one
    #
    # The pair below is the usual arrangement: 80 exists to bounce people to
    # 443.  The Location is built from the name each request asked for, so a
    # redirect covers every site on the listener without being told what they
    # are, and the port is omitted when it is 443.
    #
    #   listen  80 redirect;
    #   listen  443 ssl;
    #
    # A redirect is decided before the guards below, so a password is never
    # asked for over cleartext.
    listen      127.0.0.1:8080;

    root        /srv/www;

    # What a directory is answered with, in order -- nginx's `index`, and
    # Apache's DirectoryIndex, which Apache enables globally in
    # mods-enabled/dir.conf and so never mentions in a vhost.  This is what
    # makes a link to a site root work: GET / names a directory.
    #
    # A directory asked for without a trailing slash is answered with a 301
    # that adds one, because relative links in the page resolve against the
    # request target.
    #
    # `index;` with no arguments turns it off, and a directory becomes a 404.
    # There is no directory *listing* either way -- that is a different
    # feature, and one that publishes what is in a directory to anyone.
    index       index.html index.htm;
    prefix      /;
    access_log  -;

    # combined (the default) or vhost_combined, both spelled as Apache spells
    # them so that existing log tools already read either:
    #
    #   combined        %h %l %u %t "%r" %>s %O "%{Referer}i" "%{User-Agent}i"
    #   vhost_combined  %v:%p  prefixed onto that
    #
    # Worth turning on once one process serves both 80 and 443: combined
    # cannot say which listener answered, and "is anything still using http?"
    # is the question you ask before turning http off.  The port comes from
    # the listener rather than from Host, so a client cannot lie about it.
    # log_format  vhost_combined;

    # Sent with every 200, 206 and 304.  Quoted because it has a comma and a
    # space in it, which is the whole reason quoting exists here.
    # cache_control  "public, max-age=3600";

    # ssl_certificate      /etc/jhttpd/cert.pem;
    # ssl_certificate_key  /etc/jhttpd/key.pem;

    # --- limits ---
    #
    # These keep jhttpd's own names rather than nginx's, because they do not
    # mean what nginx's do: `limit_rate` there is bandwidth, and `limit_conn`
    # is per-key rather than a total.  A familiar name that means something
    # else is worse than an unfamiliar one.
    #
    # Zero is off for the first three, and jhttpd will not pick a number on
    # your behalf: a rate that is wrong is worse than none, because it is
    # wrong in a way that looks deliberate.
    # request_rate     10;     # requests per second, per address
    # request_burst    20;     # how many may arrive at once
    # max_per_address   8;

    # **The first four are read only by the async server.**
    #
    # max_connections is `sys::server::policy`'s, and that header says so:
    # "Ignored by a blocking server, which bounds itself with threads and
    # max_queued". The three keepalive settings are the same by construction
    # -- sys::server hands a blocking connection to the handler once, so one
    # connection is one request and there is no idle period to bound.
    #
    # Without `async;` they parse, validate, and do nothing. `--test` says so
    # when they differ from the defaults, because a knob that silently does
    # nothing is worse than one that is absent: it reads as a bound somebody
    # is relying on.
    max_connections        256;
    keepalive_requests     100;   # per connection, before it is closed
    keepalive_timeout       60;   # idle, between requests
    client_header_timeout    5;   # to send the first one

    # This one is read by both.
    io_timeout              30;

    # --- a guarded path ---
    #
    # nginx's own shape, and the reason the config exists: as a flag this was
    # --protect PREFIX:REALM:FILE, which had to be split by counting colons
    # from the right because a path may contain one and so may a realm.
    # Here they are three things and nothing has to be guessed.
    #
    # The file is what `jhttpd --hash-password` writes: USER:ARGON2ID-HASH,
    # one per line, and it must not be world-readable.
    #
    # location /private {
    #     auth_basic            "restricted area";
    #     auth_basic_user_file  /etc/jhttpd/users;
    # }

    # --- another name, on every port ---
    #
    # A request whose Host matches gets this root instead, on whichever port
    # it arrived on -- the route table is shared.  Anything nobody claimed
    # gets the `root` above.  A site may carry its own certificate,
    # which is selected by SNI -- but only if the server has one too, since
    # there would otherwise be nothing to fall back on.
    #
    # server_name takes a list, as nginx's does -- this is what Apache
    # writes as ServerName plus ServerAlias.  One site is registered per
    # name; they differ only in what a request has to say to reach them,
    # and every one of them carries the certificate, because SNI matches on
    # the name the client asked for.
    #
    # server {
    #     server_name          other.example www.other.example other.ninja;
    #     root                 /srv/other;
    #     ssl_certificate      /etc/jhttpd/other.pem;
    #     ssl_certificate_key  /etc/jhttpd/other.key;
    # }
}
