#!/usr/bin/make -f
#
# Three lines of dh(1) where there were two hundred of hand-written targets.
#
# What was here was the pre-dh multi-binary template from dh-make, with
# `#INSTALLDOC#` and `#DOCS#` placeholders that were never filled in and a
# `debian/compat` of 7 sitting under a `debhelper (>= 12)` build-dependency.
# dh does all of it, and correctly.

# Assigned with ?= so a cross-build can turn something off from the environment
# without editing this file.  Ubuntu enables LTO by default, and LTO is what
# makes gcc hit an internal compiler error under qemu emulation -- so building
# an amd64 package on an arm64 host wants optimize=-lto, while a native build
# should keep it.
DEB_BUILD_MAINT_OPTIONS ?= hardening=+all
export DEB_BUILD_MAINT_OPTIONS

%:
	dh $@ --with autoreconf

# The tree ships configure.ac rather than configure, so autoreconf runs first
# -- that is the --with above. Everything else is stock: dh_auto_configure
# passes the right --prefix, --libdir and build triplet by itself.
override_dh_auto_configure:
	dh_auto_configure -- --disable-static

# The suite needs about four minutes and binds loopback ports. Run it, because
# a package built from code that does not pass its own tests is not worth
# shipping, but say so when it is skipped with DEB_BUILD_OPTIONS=nocheck.
override_dh_auto_test:
	dh_auto_test || { echo "jlib: the test suite failed"; exit 1; }

# **jlib takes everything, then gives one file back.**
#
# The alternative is enumerating the binaries, and bin_PROGRAMS is mostly
# conditional -- alpaca, curve, neural, cuda, media, x, xjoy, joy, glx, glfw --
# so a list here would be right on the machine it was written on and short by
# one every time a dependency appears or goes. Taking the directory and
# removing the file that belongs to the other package cannot drift.
# **The unit names absolute paths; the package installs to absolute paths; and
# nothing else in this build relates the two.**  A mismatch is invisible until
# `systemctl start` on the target machine, where it fails with "No such file
# or directory" -- which names the symptom and not the cause.
#
# Checked at dh_builddeb, by which point everything is staged under
# debian/jhttpd/ and both facts are present at once.  This exists because the
# unit really did say /usr/local/bin while the package installed /usr/bin.
# **The check that would have caught this**, and the one that matters.
#
# split-by-linkage.sh moves files by reading NEEDED entries, and then checks
# its own work with the same regex -- which can only catch a disagreement
# between two patterns I wrote.  This asks dpkg instead: after dh_shlibdeps
# has computed what jlib depends on, does that answer mention an X11 stack?
#
# `jlib-gl` is in the pattern for a reason found the hard way: the first
# version of this check looked only for the runtime libraries by name, and
# passed while jlib depended on *jlib-gl* -- which pulls the identical X11
# stack through one more hop, and circularly.  Checking for the symptom's
# usual spelling is not the same as checking the property.
#
# That is the property that failed on a live server -- `jlib depends on
# libgl1; however: Package libgl1 is not installed` -- and it is computed by
# the same tool that will be believed at install time.
override_dh_shlibdeps:
	dh_shlibdeps
	@set -e; \
	bad=`grep -hoE '(libgl1|libglfw3|libglu1|libportaudio2|libx11-6|jlib-gl)[^,]*' \
	     debian/jlib.substvars 2>/dev/null || true`; \
	if [ -n "$$bad" ]; then \
	    echo "jlib would depend on an X11 stack:"; \
	    echo "$$bad"; \
	    echo "(a headless server installing jlib for sockets and strings"; \
	    echo " should not acquire one -- see debian/split-by-linkage.sh)"; \
	    exit 1; \
	fi
	@echo "jlib: Depends names no GL, X or audio runtime"

override_dh_builddeb:
	@set -e; \
	for exe in `sed -n 's/^Exec[A-Za-z]*=\([^ ]*\).*/\1/p' \
	                debian/jhttpd.service | sort -u`; do \
	    case "$$exe" in /bin/kill|/bin/sh) continue ;; esac; \
	    if [ ! -x "debian/jhttpd$$exe" ]; then \
	        echo "jhttpd.service names $$exe, which this package does not install"; \
	        exit 1; \
	    fi; \
	done; \
	for doc in `sed -n 's/^Documentation=file:\([^ ]*\).*/\1/p' \
	                debian/jhttpd.service`; do \
	    if [ ! -f "debian/jhttpd$$doc" ]; then \
	        echo "jhttpd.service documents $$doc, which this package does not install"; \
	        echo "(dh_compress gzips /usr/share/doc; see override_dh_compress)"; \
	        exit 1; \
	    fi; \
	done
	@echo "jhttpd.service: every Exec and Documentation path is installed"
	dh_builddeb

# **The example config is not compressed.**  It is documentation you copy to
# /etc/jhttpd.conf, and dh_compress gzips anything in /usr/share/doc over a
# few kilobytes by default -- which turns the path the unit's Documentation=
# names into a path that does not exist.
override_dh_compress:
	dh_compress -Xjhttpd.conf.example

# **The graphical half is split out by what it links, not by a list.**
#
# configure detects GL, GLFW, X and portaudio and builds against whatever the
# machine has.  That is why a tarball build on a headless server produces a
# headless jlib and the container -- which has every -dev package, for the
# test suite -- produces one that drags in libgl1, libglfw3, libglu1-mesa and
# libportaudio2.  Installing that on a web server wants an X11 stack to run a
# program that speaks HTTP.
#
# Derived rather than enumerated, because a list is the thing that goes stale:
# a new GL program added to jlib/apps would otherwise land in jlib and put
# libgl1 back into a headless server's dependency set, and nothing would say
# so until somebody tried to install it.
override_dh_install:
	dh_install
	rm -f debian/jlib/usr/bin/jhttpd
	# Debian policy: no .la files for shared libraries.  find, not a glob:
	# the libraries install to a multiarch directory, usr/lib/<triplet>/.
	find debian/jlib/usr/lib -name '*.la' -delete
	debian/split-by-linkage.sh debian/jlib debian/jlib-gl
