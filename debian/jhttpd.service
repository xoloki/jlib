# jhttpd under systemd.
#
#     sudo cp jhttpd.service.example /etc/systemd/system/jhttpd.service
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now jhttpd
#
# Then the usual verbs work, and each maps onto something jhttpd does:
#
#     systemctl status jhttpd     is it up, what did it say
#     systemctl reload jhttpd     SIGHUP: re-read the config, reopen the logs
#     systemctl restart jhttpd    for the parts a reload cannot change
#     journalctl -u jhttpd        everything it printed
#
# **The config must say `daemon;`.** This unit is Type=forking, so systemd
# waits for the process it started to exit and then follows PIDFile= to the
# real one. jhttpd's parent exits only after the ports are bound, the logs and
# certificate are open and privilege is dropped -- so that exit means "ready",
# truthfully, which is the whole contract Type=forking rests on.
#
# A config without `daemon;` makes systemd wait for a parent that never exits:
# it hangs until TimeoutStartSec and then kills a server that was serving
# perfectly well. ExecStartPre passes --forking so that mismatch is refused in
# a second, by a message that names it, rather than discovered by a timeout.
#
# The startup lines still reach the journal through ExecStartPre, and the
# lifecycle notices reach the error log -- which is where you look when a site
# is dark, and is exactly what was missing the day this bound loopback-only
# and said so to a stderr nobody was reading.

[Unit]
Description=jhttpd
# The example config, which the package installs.  There is no man page, and
# pointing at one that does not exist makes `systemctl show` advertise a
# document nobody can open.
Documentation=file:/usr/share/doc/jhttpd/jhttpd.conf.example
After=network-online.target
Wants=network-online.target

[Service]
# **Type=forking, and the config must say `daemon;`.** (#334)
#
# jhttpd implements this contract properly, which is what makes it the right
# choice rather than a compromise: bg.ready() exists so the parent does not
# exit until the ports are bound, the certificate and logs are open, and
# privilege is dropped.  The parent's exit is therefore a truthful readiness
# signal -- exactly what Type=forking needs, and what most daemons get wrong.
#
# Type=notify would be more precise still (bg.ready() is the natural
# sd_notify(READY=1) site) and is rejected because it means linking libsystemd.
#
# The two halves cannot see each other: the config does not know how it will
# be supervised, and systemd exports Type= nowhere.  So ExecStartPre passes
# --forking, and `--test --forking` refuses a config with no daemon;.
Type=forking
PIDFile=/run/jhttpd.pid

# **The config is checked before the old process is replaced.** A start that
# would fail on a missing root or an unreadable certificate fails here instead,
# with the reason, and whatever was running keeps running.
# /usr/bin, not /usr/local/bin: this is the packaged unit, and the package
# installs to /usr/bin.  The example unit in jlib/apps/ says /usr/local/bin
# because that is where `make install` puts it with the default prefix -- the
# two differ on purpose, and getting it wrong fails the start with "No such
# file or directory" rather than anything that names the real problem.
# **The package ships no /etc/jhttpd.conf**, deliberately: a web server that
# bound :80 the moment it was installed would fight whatever is already
# serving there, which on the machine this was written for was Apache.  Copy
# /usr/share/doc/jhttpd/jhttpd.conf.example and edit it.
#
# Until you do, ExecStartPre fails and the service does not start -- which is
# the intended behaviour, and says so rather than starting on a guess.
ExecStartPre=/usr/bin/jhttpd --config /etc/jhttpd.conf --test --forking
ExecStart=/usr/bin/jhttpd --config /etc/jhttpd.conf

# SIGHUP re-reads the config and reopens the logs. What it cannot change --
# ports, roots, the thread count -- it names, so `journalctl -u jhttpd` after a
# reload tells you whether you actually got what you edited.
ExecReload=/bin/kill -HUP $MAINPID

# SIGTERM, which jhttpd handles: it stops accepting, ends the connections it
# holds, and returns from run(). 5s is generous for that; it is normally about
# a hundred milliseconds.
KillSignal=SIGTERM
TimeoutStopSec=5

Restart=on-failure
RestartSec=2

# Started as root because binding 80 and 443 needs it, then jhttpd drops to
# whatever `user` says in the config -- after binding, and after reading the
# certificate, so the key can stay root-only on disk.
#
# The alternative is AmbientCapabilities=CAP_NET_BIND_SERVICE and User=www-data
# here, which never runs as root at all. That is stricter and it means the
# certificate has to be readable by www-data, which is a real trade rather than
# a free win.
# **There is deliberately no `User=` here, and adding one breaks the server.**
#
# A unit with no User= runs as root, which is what this needs: it binds 80 and
# 443, reads a key out of /etc/ssl/private, and opens logs under /var/log --
# all before jhttpd drops to the user its own config names.
#
# Setting `User=root` looks like harmless explicitness and is not. It makes
# systemd take its change-identity path, and together with Group= and the
# hardening below that strips **CAP_SETUID** from the effective set -- while
# leaving it in the bounding set, so `systemctl show` still lists it. jhttpd
# then fails at startup with
#
#     jhttpd: sys exception: setuid() failed: Operation not permitted
#
# which is the kernel refusing the privilege drop from a process that really
# is uid 0. Measured: with User=root the effective mask is ...ff7f, and bit 7
# is CAP_SETUID; without it, ...ffff, with every directive below still on.
#
# This cost a live deploy and four wrong diagnoses. It is one line, it reads
# like documentation, and it is the only property in this file whose removal
# is load-bearing.
#
# **Group must match the group the config drops to.**
#
# systemd creates LogsDirectory owned by User:Group, so without this it is
# root:root 0750 -- and jhttpd reopens its logs *after* dropping privilege,
# on the SIGHUP that logrotate's postrotate sends. www-data would have no
# search permission on that directory, the reopen would fail, and logging
# would stop silently after the first rotation.
#
# root:www-data 0750 gives the dropped process exactly what it needs: it can
# traverse the directory and open a log that already exists. It deliberately
# cannot *create* one, which is why the `create` line in the logrotate snippet
# is load-bearing rather than decorative -- and why a log deleted by hand
# needs a restart rather than a reload to come back.
Group=www-data

# Modest hardening. Not a complete list -- these are the ones that are clearly
# right for a static file server and do not interfere with dropping privileges
# or reading a certificate.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Where the logs go, if the config names files rather than "-". Must be
# writable by the user jhttpd drops to: the files are opened as root at
# startup, but SIGHUP reopens them *after* the drop, so a root-only directory
# means rotation silently stops working.
# **The file-descriptor bound, stated rather than inherited.**
#
# jhttpd holds two descriptors per request in flight: the connection, and the
# file it is streaming -- `located` keeps the file open across the writes, on
# both servers. So `max_connections N` needs roughly 2N descriptors, plus the
# listeners, the two logs, the reactor's own, and the signal pipe.
#
# At the default max_connections of 256 that is ~520; at the 512 a busy site
# wants, ~1032. systemd's own default varies: this unit was measured getting
# 524288 on Ubuntu 24.04, and older systemd gives services 1024 -- at which
# point 512 connections exhausts them.
#
# Running out is not a graceful degradation. accept() fails with EMFILE and
# sys::server backs off by sleeping 100ms **on the reactor thread**, which
# stalls every connection on every listener for that long, repeatedly. See
# the issue filed from #270 phase 1.
#
# 16384 covers max_connections up to about 8000 with room for everything else,
# and costs nothing to reserve.
LimitNOFILE=16384

LogsDirectory=jhttpd
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
